# ==============================================================================
# nonebot-plugin-ayasanko-chat 配置示例
# 将本文件复制或追加到您的 NoneBot2 根目录下的 .env / .env.prod 中
# ==============================================================================

# [必填] 大模型 API 密钥 (智谱/DeepSeek/OpenAI兼容服务商)
# 例如 DeepSeek 官方: sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT__API_KEY=your_api_key_here

# [可选] 大模型 API 基础地址 (结尾不需要加 /chat/completions)
# - 智谱开放平台: https://open.bigmodel.cn/api/paas/v4 (默认)
# - DeepSeek 官方: https://api.deepseek.com
# - 硅基流动: https://api.siliconflow.cn/v1
CHAT__API_BASE=https://api.deepseek.com

# [可选] 对话模型名称
# - 智谱: glm-4.5-air / glm-4-flash / glm-4v
# - DeepSeek: deepseek-chat / deepseek-reasoner (R1推理模型)
CHAT__MODEL=deepseek-reasoner

# [可选] 单次最大生成 Token 数 (默认: 1000)
CHAT__MAX_TOKENS=2000

# [可选] 采样温度 (默认: 1.0)
CHAT__TEMPERATURE=1.0

# [可选] 请求超时时间（秒，默认: 30，深度推理模型建议设为 60）
CHAT__TIMEOUT=60

# [可选] 系统预设提示词 (System Prompt)
CHAT__SYSTEM_PROMPT=你是一位聪明、可爱且乐于助人的 AI 助手。

# [可选] 触发对话的机器人昵称列表 (支持 JSON 数组或逗号分隔)
CHAT__NICKNAME=["猫猫", "小助手"]

# ------------------------------------------------------------------------------
# 思考链与流式输出配置
# ------------------------------------------------------------------------------

# 是否启用 SSE 流式接收 (默认: false)
CHAT__STREAM=false

# 是否在回复中保留并排版展示思考链 (DeepSeek reasoner / <think> 标签，默认: true)
CHAT__SHOW_THINKING=true

# ------------------------------------------------------------------------------
# 存储后端配置 (持久化 / 内存)
# ------------------------------------------------------------------------------

# 存储引擎选择:
# - memory: 纯内存 LRU + TTL 机制（默认）
# - sqlite: SQLite 数据库持久化（推荐，重启服务会话不丢失）
CHAT__STORAGE_BACKEND=sqlite

# SQLite 数据库文件存放路径 (仅在 storage_backend=sqlite 时生效)
CHAT__SQLITE_PATH=data/ayasanko_chat.db

# ------------------------------------------------------------------------------
# 会话与群聊隔离配置
# ------------------------------------------------------------------------------

# 会话有效时长（秒，超过此时长无交互将自动释放，默认: 1800 秒 / 30分钟）
CHAT__SESSION_TTL=1800

# 内存保留活跃会话上限 (超额后根据 LRU 算法自动淘汰最久未访问会话，默认: 500)
CHAT__MAX_SESSIONS=500

# 最大保留的上下文对话轮数 (默认: 10)
CHAT__MAX_HISTORY=10

# 群聊会话模式 (默认: individual)
# - individual: 群内每个人拥有独立上下文
# - shared: 群内所有人共享同一个群记忆上下文
CHAT__GROUP_SESSION_MODE=individual

# ------------------------------------------------------------------------------
# 进阶调度与高可用配置
# ------------------------------------------------------------------------------

# 全局最大并发请求数 (默认: 5)
CHAT__MAX_CONCURRENT=5

# 网络抖动/429/5xx 自动指数退避重试次数 (默认: 2，设为 0 关闭)
CHAT__MAX_RETRIES=2

# 重试基础延迟时间（秒，默认: 1.5）
CHAT__RETRY_DELAY=1.5

# ------------------------------------------------------------------------------
# 安全风控与限流配置
# ------------------------------------------------------------------------------

# 单用户/会话速率限制：时间周期内最大提问次数 (默认: 10，设为 0 关闭限流)
CHAT__RATE_LIMIT_REQUESTS=10

# 速率限制时间周期（秒，默认: 60 秒）
CHAT__RATE_LIMIT_PERIOD=60

# 群白名单列表：仅列表中的群响应对话（留空表示所有群生效）
# CHAT__WHITELIST_GROUPS=["123456789"]

# 群黑名单列表：列表中的群忽略对话
# CHAT__BLACKLIST_GROUPS=["987654321"]

# 单条消息最大字数上限，超出自动智能分段（默认: 1200）
CHAT__MAX_RESPONSE_LENGTH=1200
